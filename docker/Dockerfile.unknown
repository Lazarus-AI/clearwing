FROM debian:11-slim

# Build system: unknown | Primary language: unknown
# Fallback image for unrecognized project types

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      ripgrep ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# /scratch is mounted at runtime as a writable tmpfs
RUN mkdir -p /scratch
