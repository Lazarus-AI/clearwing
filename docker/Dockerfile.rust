FROM rust:1-slim

# Build system: cargo | Primary language: rust
# Sanitizers: not applicable (Rust sanitizers require nightly)

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      ripgrep gdb strace coreutils ca-certificates build-essential && \
    rm -rf /var/lib/apt/lists/*

ENV RUSTFLAGS="-g"
ENV CARGO_TERM_COLOR="never"

WORKDIR /workspace

# /scratch is mounted at runtime as a writable tmpfs
RUN mkdir -p /scratch
