FROM gcc:12-bullseye

# Build system: make | Primary language: c
# Mode: deep-agent (extra debugging tools)
# Default sanitizers: asan+ubsan

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      ripgrep gdb strace coreutils ca-certificates build-essential \
      python3 valgrind ccache git && \
    rm -rf /var/lib/apt/lists/*

# Optional packages (architecture-dependent, best-effort)
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ltrace 2>/dev/null || true ; \
    rm -rf /var/lib/apt/lists/*

ENV CFLAGS="-fsanitize=address -fsanitize=undefined -g -O1 -fno-omit-frame-pointer"
ENV CXXFLAGS="-fsanitize=address -fsanitize=undefined -g -O1 -fno-omit-frame-pointer"
ENV LDFLAGS="-fsanitize=address -fsanitize=undefined"
ENV ASAN_OPTIONS="abort_on_error=0:halt_on_error=0:detect_leaks=0:allocator_may_return_null=1"
ENV UBSAN_OPTIONS="print_stacktrace=1:halt_on_error=0"

WORKDIR /workspace

# /scratch is mounted at runtime as a writable tmpfs
RUN mkdir -p /scratch
